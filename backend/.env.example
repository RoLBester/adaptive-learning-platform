# ==========================================
# MongoDB Configuration
# ==========================================
# Get your MongoDB Atlas connection string from:
# https://cloud.mongodb.com/ > Connect > Drivers > Connection String
#
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Example: mongodb+srv://john_doe:MyP@ssw0rd123@cluster0.abc123.mongodb.net/AdaptiveLearning?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/AdaptiveLearning?retryWrites=true&w=majority

# ==========================================
# Hugging Face API Configuration
# ==========================================
# Get your Hugging Face API token from:
# https://huggingface.co/settings/tokens
#
# Required for: Llama 2 chatbot functionality
# Permissions needed: Read access
# Format: hf_<40 random characters>
# Example: hf_AbCdEfGhIjKlMnOpQrStUvWxYz1234567890AbCd
HUGGINGFACE_TOKEN=hf_YourHuggingFaceTokenHere1234567890
